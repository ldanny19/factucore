server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /config.js {
        alias ${FACTUCORE_WEB_CONFIG}/config.js;
        default_type application/javascript;
        add_header Cache-Control "no-store";
    }

    location = /mensajes.js {
        alias ${FACTUCORE_WEB_CONFIG}/mensajes.js;
        default_type application/javascript;
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
