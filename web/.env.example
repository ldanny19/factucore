# URL base del API REST de FactuCore. Ajustar según el entorno.
VITE_API_BASE_URL=http://localhost:8080/facturador-api

# Configuración OIDC pública de Keycloak; completar según el entorno.
VITE_OIDC_AUTHORITY=http://localhost:8080/auth/realms/facturador
VITE_OIDC_CLIENT_ID=factucore-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
