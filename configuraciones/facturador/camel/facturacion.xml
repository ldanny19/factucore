<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="facturador-workflow-procesar">
        <from uri="direct:facturador.workflow.procesar"/>
        <bean ref="workflowContextFactory" method="crear"/>
        <bean ref="workflowIdempotencyStep" method="ejecutar"/>
        <choice>
            <when>
                <simple>${body.idempotente} == true</simple>
                <bean ref="comprobanteWorkflowResponseFactory" method="crear"/>
            </when>
            <otherwise>
        <doTry>
            <setProperty name="workflow.contexto">
                <simple>${body}</simple>
            </setProperty>
            <setProperty name="workflow.etapa">
                <constant>VALIDACION</constant>
            </setProperty>
            <bean ref="validacionComprobanteWorkflowStep" method="ejecutar"/>
            <bean ref="workflowStepResultHandler" method="registrarResultado"/>
            <doCatch>
                <exception>java.lang.Exception</exception>
                <bean ref="workflowStepResultHandler" method="registrarExcepcion"/>
                <setBody>
                    <exchangeProperty>workflow.contexto</exchangeProperty>
                </setBody>
            </doCatch>
        </doTry>
        <choice>
            <when>
                <simple>${body.ultimoResultado.exitosa} == true</simple>
        <doTry>
            <setProperty name="workflow.contexto">
                <simple>${body}</simple>
            </setProperty>
            <setProperty name="workflow.etapa">
                <constant>ASIGNACION_SECUENCIAL</constant>
            </setProperty>
            <bean ref="reservaComprobanteWorkflowStep" method="ejecutar"/>
            <bean ref="workflowStepResultHandler" method="registrarResultado"/>
            <doCatch>
                <exception>java.lang.Exception</exception>
                <bean ref="workflowStepResultHandler" method="registrarExcepcion"/>
                <setBody>
                    <exchangeProperty>workflow.contexto</exchangeProperty>
                </setBody>
            </doCatch>
        </doTry>
        <choice>
            <when>
                <simple>${body.ultimoResultado.exitosa} == true</simple>
        <doTry>
            <setProperty name="workflow.contexto">
                <simple>${body}</simple>
            </setProperty>
            <setProperty name="workflow.etapa">
                <constant>GENERACION_XML</constant>
            </setProperty>
            <bean ref="generacionXmlWorkflowStep" method="ejecutar"/>
            <bean ref="workflowStepResultHandler" method="registrarResultado"/>
            <doCatch>
                <exception>java.lang.Exception</exception>
                <bean ref="workflowStepResultHandler" method="registrarExcepcion"/>
                <setBody>
                    <exchangeProperty>workflow.contexto</exchangeProperty>
                </setBody>
            </doCatch>
        </doTry>
        <choice>
            <when>
                <simple>${body.ultimoResultado.exitosa} == true</simple>
        <doTry>
            <setProperty name="workflow.contexto">
                <simple>${body}</simple>
            </setProperty>
            <setProperty name="workflow.etapa">
                <constant>VALIDACION_XSD</constant>
            </setProperty>
            <bean ref="validacionXsdWorkflowStep" method="ejecutar"/>
            <bean ref="workflowStepResultHandler" method="registrarResultado"/>
            <doCatch>
                <exception>java.lang.Exception</exception>
                <bean ref="workflowStepResultHandler" method="registrarExcepcion"/>
                <setBody>
                    <exchangeProperty>workflow.contexto</exchangeProperty>
                </setBody>
            </doCatch>
        </doTry>
        <choice>
            <when>
                <simple>${body.ultimoResultado.exitosa} == true</simple>
        <doTry>
            <setProperty name="workflow.contexto">
                <simple>${body}</simple>
            </setProperty>
            <setProperty name="workflow.etapa">
                <constant>FIRMA_ELECTRONICA</constant>
            </setProperty>
            <bean ref="firmaElectronicaWorkflowStep" method="ejecutar"/>
            <bean ref="workflowStepResultHandler" method="registrarResultado"/>
            <doCatch>
                <exception>java.lang.Exception</exception>
                <bean ref="workflowStepResultHandler" method="registrarExcepcion"/>
                <setBody>
                    <exchangeProperty>workflow.contexto</exchangeProperty>
                </setBody>
            </doCatch>
        </doTry>
        <choice>
            <when>
                <simple>${body.ultimoResultado.exitosa} == true</simple>
        <doTry>
            <setProperty name="workflow.contexto">
                <simple>${body}</simple>
            </setProperty>
            <setProperty name="workflow.etapa">
                <constant>ENVIO_SRI</constant>
            </setProperty>
            <bean ref="envioSriWorkflowStep" method="ejecutar"/>
            <bean ref="workflowStepResultHandler" method="registrarResultado"/>
            <doCatch>
                <exception>java.lang.Exception</exception>
                <bean ref="workflowStepResultHandler" method="registrarExcepcion"/>
                <setBody>
                    <exchangeProperty>workflow.contexto</exchangeProperty>
                </setBody>
            </doCatch>
        </doTry>
        <choice>
            <when>
                <simple>${body.ultimoResultado.exitosa} == true</simple>
        <doTry>
            <setProperty name="workflow.contexto">
                <simple>${body}</simple>
            </setProperty>
            <setProperty name="workflow.etapa">
                <constant>AUTORIZACION_SRI</constant>
            </setProperty>
            <bean ref="autorizacionSriWorkflowStep" method="ejecutar"/>
            <bean ref="workflowStepResultHandler" method="registrarResultado"/>
            <doCatch>
                <exception>java.lang.Exception</exception>
                <bean ref="workflowStepResultHandler" method="registrarExcepcion"/>
                <setBody>
                    <exchangeProperty>workflow.contexto</exchangeProperty>
                </setBody>
            </doCatch>
        </doTry>
        <choice>
            <when>
                <simple>${body.ultimoResultado.exitosa} == true</simple>
                    <choice>
                        <when>
                            <simple>${body.comprobante.estadoProceso} == 'AUTORIZADO'</simple>
        <doTry>
            <setProperty name="workflow.contexto">
                <simple>${body}</simple>
            </setProperty>
            <setProperty name="workflow.etapa">
                <constant>GENERACION_RIDE</constant>
            </setProperty>
            <bean ref="generacionRideWorkflowStep" method="ejecutar"/>
            <bean ref="workflowStepResultHandler" method="registrarResultado"/>
            <doCatch>
                <exception>java.lang.Exception</exception>
                <bean ref="workflowStepResultHandler" method="registrarExcepcion"/>
                <setBody>
                    <exchangeProperty>workflow.contexto</exchangeProperty>
                </setBody>
            </doCatch>
        </doTry>
        <choice>
            <when>
                <simple>${body.ultimoResultado.exitosa} == true</simple>
        <doTry>
            <setProperty name="workflow.contexto">
                <simple>${body}</simple>
            </setProperty>
            <setProperty name="workflow.etapa">
                <constant>NOTIFICACION</constant>
            </setProperty>
            <bean ref="notificacionWorkflowStep" method="ejecutar"/>
            <bean ref="workflowStepResultHandler" method="registrarResultado"/>
            <doCatch>
                <exception>java.lang.Exception</exception>
                <bean ref="workflowStepResultHandler" method="registrarExcepcion"/>
                <setBody>
                    <exchangeProperty>workflow.contexto</exchangeProperty>
                </setBody>
            </doCatch>
        </doTry>
        <choice>
            <when>
                <simple>${body.ultimoResultado.exitosa} == true</simple>
                        </when>
                    </choice>
                    <bean ref="comprobanteWorkflowResponseFactory" method="crear"/>
            </otherwise>
        </choice>
    </route>
    <route id="facturador-workflow-reprocesar">
        <from uri="direct:facturador.workflow.reprocesar"/>
        <bean ref="comprobanteReprocessService" method="reprocesarAutorizacion"/>
    </route>
</routes>
