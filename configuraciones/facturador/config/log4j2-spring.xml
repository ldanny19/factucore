<?xml version="1.0" encoding="UTF-8"?>
<Configuration monitorInterval="30">
	<Properties>
		<Property name="LOG_PATH">${env:FACTUCORE_PATH_LOGS:-/app/logs}</Property>
		<Property name="LOG_FILE">facturador.log</Property>
		<Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %notEmpty{ID_TRANSACCION=%X{idTransaccion} - }%c{1.} - %msg%n</Property>
	</Properties>
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="${LOG_PATTERN}" />
		</Console>
		<RollingFile name="File"
			fileName="${LOG_PATH}/${LOG_FILE}"
			filePattern="${LOG_PATH}/${date:yyyy-MM}/factucore-%d{yyyy-MM-dd}-%i.log.gz">
			<PatternLayout pattern="${LOG_PATTERN}" />
			<Policies>
				<TimeBasedTriggeringPolicy interval="1" />
				<SizeBasedTriggeringPolicy size="20 MB" />
			</Policies>
			<DefaultRolloverStrategy max="30" />
		</RollingFile>
	</Appenders>
	<Loggers>
		<Logger name="ec.dalara.factucore.application.workflow"
			level="INFO" additivity="false">
			<AppenderRef ref="Console" />
			<AppenderRef ref="File" />
		</Logger>
		<Logger name="ec.dalara.factucore.application.workflow.WorkflowEtapaExecutor"
			level="DEBUG" additivity="false">
			<AppenderRef ref="Console" />
			<AppenderRef ref="File" />
		</Logger>
		<Logger name="ec.dalara.factucore"
			level="INFO" additivity="false">
			<AppenderRef ref="Console" />
			<AppenderRef ref="File" />
		</Logger>
		<Logger name="ec.dalara.factucore.messaging.infrastructure.kafka.KafkaBrokerMensajeria"
			level="INFO" additivity="false">
			<AppenderRef ref="Console" />
			<AppenderRef ref="File" />
		</Logger>
		<Logger name="org.hibernate.SQL" level="WARN" />
		<Logger name="org.hibernate.orm.jdbc.bind" level="WARN" />
		<Logger name="org.springframework" level="WARN" />
		<Logger name="org.hibernate" level="WARN" />
		<Logger name="org.apache.camel" level="INFO" />
		<Root level="INFO">
			<AppenderRef ref="Console" />
			<AppenderRef ref="File" />
		</Root>
	</Loggers>
</Configuration>
