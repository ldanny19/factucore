        </doTry>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Resultado Ejecutando etapa NOTIFICACION=${exchangeProperty.workflow.resultado}"/>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Fin Etapa NOTIFICACION - Resultado=${exchangeProperty.workflow.resultado}"/>

        <choice>
                    <when>
                        <simple>${exchangeProperty.workflow.resultado} == 'OK'</simple>
                        <to uri="direct:facturador.workflow.nodo.GENERAR_RESPUESTA"/>
                    </when>
                    <when>
                        <simple>${exchangeProperty.workflow.resultado} == 'ERROR'</simple>
                        <to uri="direct:facturador.workflow.nodo.RESPUESTA_ERROR_NOTIFICACION"/>
                    </when>
        </choice>
    </route>

    <!-- Prepara una respuesta para éxito o error crítico. -->
    <route id="facturador-workflow-generar-respuesta">
        <from uri="direct:facturador.workflow.nodo.GENERAR_RESPUESTA"/>
        <setProperty name="workflow.contexto"><simple>${body}</simple></setProperty>
        <setProperty name="workflow.etapa"><constant>GENERAR_RESPUESTA</constant></setProperty>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Ejecutando etapa GENERAR_RESPUESTA"/>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Inicia Etapa GENERAR_RESPUESTA"/>

        <bean ref="generarRespuestaWorkflowStep" method="ejecutar"/>
        <setProperty name="workflow.resultado"><simple>${body}</simple></setProperty>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Resultado Ejecutando etapa GENERAR_RESPUESTA=${exchangeProperty.workflow.resultado}"/>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Fin Etapa GENERAR_RESPUESTA - Resultado=${exchangeProperty.workflow.resultado}"/>

        <setBody><simple>${exchangeProperty.workflow.contexto}</simple></setBody>
        <to uri="direct:facturador.workflow.nodo.FIN"/>
    </route>

    <!-- El fallo de correo genera un mensaje informativo sin convertir el proceso en error. -->
    <route id="facturador-workflow-respuesta-error-notificacion">
        <from uri="direct:facturador.workflow.nodo.RESPUESTA_ERROR_NOTIFICACION"/>
        <setProperty name="workflow.contexto"><simple>${body}</simple></setProperty>
        <setProperty name="workflow.etapa"><constant>RESPUESTA_ERROR_NOTIFICACION</constant></setProperty>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Ejecutando etapa RESPUESTA_ERROR_NOTIFICACION"/>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Inicia Etapa RESPUESTA_ERROR_NOTIFICACION"/>

        <bean ref="respuestaErrorNotificacionWorkflowStep" method="ejecutar"/>
        <setProperty name="workflow.resultado"><simple>${body}</simple></setProperty>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Resultado Ejecutando etapa RESPUESTA_ERROR_NOTIFICACION=${exchangeProperty.workflow.resultado}"/>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Fin Etapa RESPUESTA_ERROR_NOTIFICACION - Resultado=${exchangeProperty.workflow.resultado}"/>

        <setBody><simple>${exchangeProperty.workflow.contexto}</simple></setBody>
        <to uri="direct:facturador.workflow.nodo.FIN"/>
    </route>

    <!-- Único nodo terminal del grafo. -->
    <route id="facturador-workflow-fin">
        <from uri="direct:facturador.workflow.nodo.FIN"/>
        <setProperty name="workflow.contexto"><simple>${body}</simple></setProperty>
        <setProperty name="workflow.etapa"><constant>FIN</constant></setProperty>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Ejecutando etapa FIN"/>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Inicia Etapa FIN"/>
        <bean ref="finWorkflowStep" method="ejecutar"/>
        <setProperty name="workflow.resultado"><simple>${body}</simple></setProperty>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Resultado Ejecutando etapa FIN=${exchangeProperty.workflow.resultado}"/>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Fin Etapa FIN - Resultado=${exchangeProperty.workflow.resultado}"/>

        <setBody><simple>${exchangeProperty.workflow.contexto}</simple></setBody>
        <bean ref="finWorkflowStep" method="respuesta"/>
    </route>

    <route id="facturador-workflow-reprocesar">
        <from uri="direct:facturador.workflow.reprocesar"/>
        <bean ref="comprobanteReprocessService" method="reprocesarAutorizacion"/>
    </route>
</routes>
