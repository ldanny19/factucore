<?xml version="1.0" encoding="UTF-8"?>
<!--
    Workflow de facturación electrónica de FactuCore.

    El XML define el grafo de ejecución. Cada nodo invoca un Bean, recibe una
    salida textual y decide el siguiente nodo. Los Beans no conocen ni
    implementan las transiciones.

    Convenciones:
      - OK / ERROR: resultado genérico de una etapa.
      - RECIBIDO: recepción aceptada por SRI; continúa a autorización.
      - RECHAZADO: recepción rechazada por SRI; prepara respuesta.
      - AUTORIZADO: comprobante autorizado; continúa a RIDE.
      - EN_PROCESO: autorización aún pendiente; termina el intento actual.
      - NO_AUTORIZADO: SRI no autorizó el comprobante.
      - Existe un único nodo FIN.
      - Los errores críticos pasan por GENERAR_RESPUESTA.
      - El error de correo pasa por RESPUESTA_ERROR_NOTIFICACION y no invalida
        la facturación.
-->
<routes xmlns="http://camel.apache.org/schema/spring">

    <route id="facturador-workflow-procesar">
        <from uri="direct:facturador.workflow.procesar"/>
        <bean ref="workflowContextFactory" method="crear"/>
        <to uri="direct:facturador.workflow.nodo.INICIO"/>
    </route>

    <!-- Nodo INICIO: punto de entrada del workflow para una nueva solicitud. -->
    <route id="facturador-workflow-inicio">
        <from uri="direct:facturador.workflow.nodo.INICIO"/>
        <setProperty name="workflow.contexto"><simple>${body}</simple></setProperty>
        <setProperty name="workflow.etapa"><constant>INICIO</constant></setProperty>
        <setProperty name="workflow.resultado"><constant>OK</constant></setProperty>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Ejecutando etapa INICIO"/>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Inicia Etapa INICIO"/>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Resultado Ejecutando etapa INICIO=${exchangeProperty.workflow.resultado}"/>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Fin Etapa INICIO - Resultado=${exchangeProperty.workflow.resultado}"/>
        <to uri="direct:facturador.workflow.nodo.VALIDACION"/>
    </route>

    <!-- Nodo VALIDACION: ejecuta el Bean y solo interpreta su resultado. -->
    <route id="facturador-workflow-validacion">
        <from uri="direct:facturador.workflow.nodo.VALIDACION"/>
        <setProperty name="workflow.contexto"><simple>${body}</simple></setProperty>
        <setProperty name="workflow.etapa"><constant>VALIDACION</constant></setProperty>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Ejecutando etapa VALIDACION"/>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Inicia Etapa VALIDACION"/>
        <doTry>
            <bean ref="validacionComprobanteWorkflowStep" method="ejecutar"/>
            <setProperty name="workflow.resultado"><simple>${body}</simple></setProperty>
            <bean ref="workflowStepResultHandler" method="registrarResultado"/>
            <doCatch>
                <exception>java.lang.Exception</exception>
                <bean ref="workflowStepResultHandler" method="registrarExcepcion"/>
                <setProperty name="workflow.resultado"><constant>ERROR</constant></setProperty>
            </doCatch>
        </doTry>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Resultado Ejecutando etapa VALIDACION=${exchangeProperty.workflow.resultado}"/>
        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Fin Etapa VALIDACION - Resultado=${exchangeProperty.workflow.resultado}"/>

        <choice>
                    <when>
                        <simple>${body.idempotente} == true</simple>
                        <to uri="direct:facturador.workflow.nodo.GENERAR_RESPUESTA"/>
                    </when>
                    <when>
                        <simple>${exchangeProperty.workflow.resultado} == 'OK'</simple>
                        <to uri="direct:facturador.workflow.nodo.ASIGNACION_SECUENCIAL"/>
                    </when>
                    <when>
                        <simple>${exchangeProperty.workflow.resultado} == 'ERROR'</simple>
                        <to uri="direct:facturador.workflow.nodo.GENERAR_RESPUESTA"/>
                    </when>
        </choice>
    </route>
    <!-- Nodo ASIGNACION_SECUENCIAL: ejecuta el Bean y solo interpreta su resultado. -->
