        <log logName="ec.dalara.factucore.application.workflow" loggingLevel="DEBUG" message="ID_TRANSACCION=${exchangeProperty.workflow.contexto.solicitud.idTransaccion} - Fin Etapa ASIGNACION_SECUENCIAL - Resultado=${exchangeProperty.workflow.resultado}"/>

