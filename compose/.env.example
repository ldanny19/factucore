# Configuracion local de FactuCore.
# Copia este archivo como compose/.env y ajusta los valores de tu ambiente.
# compose/.env no se versiona. No guardar contrasenas ni tokens aqui;
# los secretos se administran mediante Vault.

# Version de las imagenes de FactuCore (obligatoria).
FACTUCORE_VERSION=1.0.0

# Raiz local unica. Cada servicio mantiene sus datos/configuracion en su propia subcarpeta.
FACTUCORE_HOME=C:/factucore
VAULT_PORT=8200

# PostgreSQL
POSTGRES_PORT=5432
DB_FACTURADOR_URL=jdbc:postgresql://db_factucore:5432/db_factucore
DB_FACTURADOR_USERNAME=usr_factucore
DB_NOTIFICACION_URL=jdbc:postgresql://db_factucore:5432/db_notificaciones
DB_NOTIFICACION_USERNAME=usr_notificaciones

# Puertos publicados de los servicios
KAFKA_PORT=9092
FACTURADOR_PORT=8081
NOTIFICACION_PORT=8082

# Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_HTTP_ENABLED=true
KC_HOSTNAME=http://api.facturador.com:8080/auth
KC_DB=postgres
KC_HOSTNAME_STRICT=false
KEYCLOAK_REALM=facturador

# Seguridad OAuth2/OIDC
# Las URLs OIDC públicas se sirven por el API Gateway bajo /auth.
# El realm se mantiene como configuración de Keycloak y se reutiliza en el issuer.
# Sobrescribe estas variables solo si cambia el dominio/ruta pública o el servicio interno.
# FACTUCORE_SEGURIDAD_OAUTH2_ISSUER_URI=http://api.facturador.com:8080/auth/realms/facturador
# FACTUCORE_SEGURIDAD_OAUTH2_JWK_SET_URI=http://auth-server:8080/auth/realms/facturador/protocol/openid-connect/certs

# Mensajeria
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Auditoria HTTP
FACTUCORE_AUDITORIA_PETICION_HABILITADA=true

# SRI
FACTUCORE_SRI_AMBIENTE=PRUEBAS

# Configuracion general
FACTUCORE_CONFIGURACION_ZONA_HORARIA=America/Guayaquil
